---
import type { MarkdownHeading } from 'astro';
import 'katex/dist/katex.min.css';
import BaseHead from '../components/BaseHead.astro';
import Comments from '../components/Comments.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { formatDate, outlineItems } from '../utils/content.mjs';

interface Props {
	title: string;
	description?: string;
	pubDate: Date;
	updatedDate?: Date;
	category: string;
	categoryName: string;
	contentHeading?: string;
	headings?: MarkdownHeading[];
	previous?: string;
	next?: string;
}

const { title, description, pubDate, updatedDate, category, categoryName, contentHeading, headings = [], previous, next } = Astro.props;
const duplicateContentTitle = contentHeading === title;
const outline = outlineItems(headings, duplicateContentTitle ? title : undefined);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${title} · ${SITE_TITLE}`} description={description ?? title} keywords={[category, categoryName]} />
	</head>
	<body>
		<div class="site-shell">
			<Header />
			<main id="main-content" class="page-content article-page">
				<article class:list={{ 'duplicate-content-title': duplicateContentTitle }}>
					<header class="article-header">
						<p class="article-kicker">{categoryName}</p>
						<h1>{title}</h1>
						{description && <p class="article-description">{description}</p>}
						<p class="article-meta">
							<span>发布于 <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></span>
							{updatedDate && <span>更新于 <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>}
						</p>
					</header>
					<div class="prose">
						<slot />
					</div>
					<nav class="article-navigation" aria-label="文章导航">
						{previous && <a class="previous" href={`/blog/${previous}/`}>上一篇</a>}
						{previous && <span aria-hidden="true">|</span>}
						<a class="home" href="/">回首页</a>
						{next && <span aria-hidden="true">|</span>}
						{next && <a class="next" href={`/blog/${next}/`}>下一篇</a>}
					</nav>
					<Comments />
				</article>
			</main>
			<dialog id="image-viewer" class="image-viewer" aria-label="图片查看器" data-image-viewer>
				<div class="image-viewer-stage" data-image-viewer-stage>
					<div class="image-viewer-track" data-image-viewer-track>
						<img alt="" aria-hidden="true" draggable="false" data-image-viewer-previous-content />
						<img alt="" draggable="false" data-image-viewer-content />
						<img alt="" aria-hidden="true" draggable="false" data-image-viewer-next-content />
					</div>
				</div>
				<p class="image-viewer-counter" aria-live="polite" data-image-viewer-counter></p>
				<form method="dialog">
					<button type="button" aria-label="关闭图片查看器" data-image-viewer-close>
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
					</button>
				</form>
				<button class="image-viewer-previous" type="button" aria-label="上一张图片" data-image-viewer-previous>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg>
				</button>
				<button class="image-viewer-next" type="button" aria-label="下一张图片" data-image-viewer-next>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
				</button>
				<div class="image-viewer-zoom" role="group" aria-label="缩放控制">
					<button type="button" aria-label="缩小图片" data-image-viewer-zoom-out>
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /></svg>
					</button>
					<button class="image-viewer-scale" type="button" aria-label="重置图片缩放" data-image-viewer-reset>100%</button>
					<button type="button" aria-label="放大图片" data-image-viewer-zoom-in>
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5v14" /></svg>
					</button>
				</div>
			</dialog>
			{
				outline.length > 1 && (
					<>
						<button
							class="outline-island"
							type="button"
							aria-haspopup="dialog"
							aria-controls="article-outline"
							data-outline-open
						>
							<span class="outline-path">
								<span class="outline-ancestors" data-outline-ancestors></span>
								<span class="outline-current" data-outline-current>{outline[0].text}</span>
							</span>
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4v16M9 7h10M9 12h7M9 17h10" /></svg>
						</button>

						<aside class="outline-sidebar" aria-label="文章目录" data-outline-sidebar>
							<p>文章目录</p>
							<nav>
								<ol>
									{outline.map(({ depth, slug, text }) => (
										<li data-depth={depth}>
											<a href={`#${slug}`} data-outline-link data-depth={depth}>{text}</a>
										</li>
									))}
								</ol>
							</nav>
						</aside>

						<dialog id="article-outline" class="outline-dialog" aria-labelledby="outline-title" data-outline-dialog>
							<header class="outline-header">
								<div>
									<p>阅读路径</p>
									<h2 id="outline-title">文章目录</h2>
								</div>
								<form method="dialog">
									<button type="submit" aria-label="关闭目录">
										<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
									</button>
								</form>
							</header>
							<nav aria-label="文章目录">
								<ol>
									{outline.map(({ depth, slug, text, path }) => (
										<li data-depth={depth}>
											<a href={`#${slug}`} data-outline-link data-depth={depth} data-path={path}>{text}</a>
										</li>
									))}
								</ol>
							</nav>
						</dialog>
					</>
				)
			}
			<Footer />
		</div>
	</body>
</html>

<script>
	const opener = document.querySelector<HTMLButtonElement>('[data-outline-open]');
	const dialog = document.querySelector<HTMLDialogElement>('[data-outline-dialog]');
	const ancestors = document.querySelector<HTMLElement>('[data-outline-ancestors]');
	const current = document.querySelector<HTMLElement>('[data-outline-current]');
	const dialogLinks = [...(dialog?.querySelectorAll<HTMLAnchorElement>('[data-outline-link]') ?? [])];
	const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-outline-link]')];
	const sidebar = document.querySelector<HTMLElement>('[data-outline-sidebar]');
	const articleHeader = document.querySelector<HTMLElement>('.article-header');
	const imageViewer = document.querySelector<HTMLDialogElement>('[data-image-viewer]');
	const viewerImage = imageViewer?.querySelector<HTMLImageElement>('[data-image-viewer-content]');
	const previousViewerImage = imageViewer?.querySelector<HTMLImageElement>('[data-image-viewer-previous-content]');
	const nextViewerImage = imageViewer?.querySelector<HTMLImageElement>('[data-image-viewer-next-content]');
	const viewerStage = imageViewer?.querySelector<HTMLElement>('[data-image-viewer-stage]');
	const viewerTrack = imageViewer?.querySelector<HTMLElement>('[data-image-viewer-track]');
	const viewerCounter = imageViewer?.querySelector<HTMLElement>('[data-image-viewer-counter]');
	const viewerClose = imageViewer?.querySelector<HTMLButtonElement>('[data-image-viewer-close]');
	const previousImage = imageViewer?.querySelector<HTMLButtonElement>('[data-image-viewer-previous]');
	const nextImage = imageViewer?.querySelector<HTMLButtonElement>('[data-image-viewer-next]');
	const zoomOut = imageViewer?.querySelector<HTMLButtonElement>('[data-image-viewer-zoom-out]');
	const zoomIn = imageViewer?.querySelector<HTMLButtonElement>('[data-image-viewer-zoom-in]');
	const resetZoom = imageViewer?.querySelector<HTMLButtonElement>('[data-image-viewer-reset]');
	const articleImages = [...document.querySelectorAll<HTMLImageElement>('.prose img:not([src^="data:"])')];
	const codeBlocks = [...document.querySelectorAll<HTMLElement>('.prose pre')];
	const desktopOutline = matchMedia('(min-width: 1220px)');
	const sections = dialogLinks.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))));
	const footer = document.querySelector<HTMLElement>('.site-footer');
	let positions: number[] = [];
	let frame = 0;
	let currentIndex = -1;
	let imageIndex = 0;
	let scale = 1;
	let panX = 0;
	let panY = 0;
	let pinchDistance = 0;
	let pinchCenter = { x: 0, y: 0 };
	let swipeStart = { x: 0, y: 0 };
	let didPinch = false;
	let isSliding = false;
	let pendingImageIndex: number | undefined;
	let closeTimer: ReturnType<typeof setTimeout>;
	const pointers = new Map<number, { x: number; y: number }>();

	codeBlocks.forEach((codeBlock) => {
		const code = codeBlock.querySelector('code');
		if (!code) return;
		const wrapper = document.createElement('div');
		const button = document.createElement('button');
		wrapper.className = 'code-block';
		button.className = 'code-copy';
		button.type = 'button';
		button.setAttribute('aria-label', '复制代码');
		button.innerHTML = '<svg class="code-copy-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 8h9a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z"/><path d="M16 8V6a1 1 0 0 0-1-1H6a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h2"/></svg><svg class="code-copy-success" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>';
		codeBlock.before(wrapper);
		wrapper.append(codeBlock, button);
		let resetTimer: ReturnType<typeof setTimeout>;
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(code.textContent ?? '');
				button.dataset.copied = 'true';
				button.setAttribute('aria-label', '代码已复制');
			} catch {
				button.setAttribute('aria-label', '复制失败');
			}
			clearTimeout(resetTimer);
			resetTimer = setTimeout(() => {
				delete button.dataset.copied;
				button.setAttribute('aria-label', '复制代码');
			}, 2000);
		});
	});

	const measure = () => {
		positions = sections.map((section) => (section?.getBoundingClientRect().top ?? 0) + scrollY);
		sync();
	};
	const sync = () => {
		cancelAnimationFrame(frame);
		frame = requestAnimationFrame(() => {
			const threshold = scrollY + (document.querySelector<HTMLElement>('.site-header')?.offsetHeight ?? 0) + 32;
			// ponytail: article outlines stay small enough for a linear scan; index offsets if they ever reach thousands of entries.
			const index = Math.max(0, positions.findLastIndex((top) => top <= threshold));
			const currentHash = dialogLinks[index]?.hash;
			links.forEach((link) => {
				if (link.hash === currentHash) link.setAttribute('aria-current', 'location');
				else link.removeAttribute('aria-current');
			});
			const parts = (dialogLinks[index]?.dataset.path ?? '').split(' › ');
			if (current) current.textContent = parts.pop() ?? '';
			if (ancestors) ancestors.textContent = parts.join(' › ');
			if (opener) opener.title = dialogLinks[index]?.dataset.path ?? '';
			if (opener && footer) opener.style.setProperty('--footer-offset', `${Math.max(0, innerHeight - footer.getBoundingClientRect().top)}px`);
			if (sidebar && desktopOutline.matches) {
				const maxHeight = Math.min(576, innerHeight - (document.querySelector<HTMLElement>('.site-header')?.offsetHeight ?? 0) - 32);
				const centered = (innerHeight - maxHeight) / 2;
				const aligned = articleHeader?.getBoundingClientRect().bottom ?? 0;
				const top = Math.max(centered, aligned);
				sidebar.style.top = `${top}px`;
				sidebar.style.transform = 'none';
				sidebar.style.setProperty('--outline-height', `${Math.min(maxHeight, innerHeight - top - 16)}px`);
			} else if (sidebar) {
				sidebar.style.removeProperty('top');
				sidebar.style.removeProperty('transform');
				sidebar.style.removeProperty('--outline-height');
			}
			if (index !== currentIndex) sidebar?.querySelector<HTMLAnchorElement>('[aria-current]')?.scrollIntoView({ block: 'nearest' });
			currentIndex = index;
		});
	};

	opener?.addEventListener('click', () => {
		dialog?.showModal();
		dialogLinks.find((link) => link.hasAttribute('aria-current'))?.focus();
	});
	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog) dialog.close();
	});
	dialogLinks.forEach((link) => link.addEventListener('click', () => dialog?.close()));
	const closeImageViewer = () => {
		if (!imageViewer?.open || imageViewer.dataset.closing === 'true') return;
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
			imageViewer.close();
			return;
		}
		imageViewer.dataset.closing = 'true';
		closeTimer = setTimeout(() => imageViewer.close(), 160);
	};
	const clampPan = () => {
		if (!viewerImage || !viewerStage) return;
		const style = getComputedStyle(viewerStage);
		const availableWidth = viewerStage.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
		const availableHeight = viewerStage.clientHeight - parseFloat(style.paddingTop) - parseFloat(style.paddingBottom);
		const limitX = Math.max(0, (viewerImage.clientWidth * scale - availableWidth) / 2);
		const limitY = Math.max(0, (viewerImage.clientHeight * scale - availableHeight) / 2);
		panX = Math.max(-limitX, Math.min(limitX, panX));
		panY = Math.max(-limitY, Math.min(limitY, panY));
	};
	const applyImageTransform = () => {
		if (!viewerImage || !resetZoom) return;
		clampPan();
		viewerImage.style.transform = `translate3d(${panX}px, ${panY}px, 0) scale(${scale})`;
		viewerImage.dataset.zoomed = scale > 1 ? 'true' : 'false';
		resetZoom.textContent = `${Math.round(scale * 100)}%`;
	};
	const setScale = (nextScale: number, originX = innerWidth / 2, originY = innerHeight / 2) => {
		const clampedScale = Math.max(1, Math.min(5, nextScale));
		const ratio = clampedScale / scale;
		panX += (originX - innerWidth / 2 - panX) * (1 - ratio);
		panY += (originY - innerHeight / 2 - panY) * (1 - ratio);
		scale = clampedScale;
		applyImageTransform();
	};
	const resetImageTransform = () => {
		scale = 1;
		panX = 0;
		panY = 0;
		applyImageTransform();
	};
	const setTrackOffset = (offset: number, dragging = false) => {
		if (!viewerTrack) return;
		viewerTrack.dataset.dragging = String(dragging);
		viewerTrack.style.transform = `translate3d(calc(-100% + ${offset}px), 0, 0)`;
	};
	const resetTrack = () => {
		if (!viewerTrack) return;
		setTrackOffset(0, true);
		viewerTrack.getBoundingClientRect();
		viewerTrack.dataset.dragging = 'false';
	};
	const setViewerImage = (target: HTMLImageElement | undefined, index: number) => {
		if (!target) return;
		const image = articleImages[index];
		target.hidden = !image;
		if (image) target.src = image.currentSrc || image.src;
	};
	const showImage = (index: number) => {
		if (!viewerImage || !viewerCounter || articleImages.length === 0) return;
		imageIndex = Math.max(0, Math.min(articleImages.length - 1, index));
		const image = articleImages[imageIndex];
		viewerImage.src = image.currentSrc || image.src;
		viewerImage.alt = image.alt;
		setViewerImage(previousViewerImage, imageIndex - 1);
		setViewerImage(nextViewerImage, imageIndex + 1);
		viewerCounter.textContent = `${imageIndex + 1} / ${articleImages.length}`;
		if (previousImage) previousImage.disabled = imageIndex === 0;
		if (nextImage) nextImage.disabled = imageIndex === articleImages.length - 1;
		isSliding = false;
		pendingImageIndex = undefined;
		resetTrack();
		resetImageTransform();
	};
	const slideTo = (index: number) => {
		if (!viewerTrack || isSliding || index < 0 || index >= articleImages.length) {
			setTrackOffset(0);
			return;
		}
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
			showImage(index);
			return;
		}
		isSliding = true;
		pendingImageIndex = index;
		viewerTrack.dataset.dragging = 'false';
		viewerTrack.style.transform = `translate3d(${index < imageIndex ? '0' : '-200%'}, 0, 0)`;
	};
	viewerTrack?.addEventListener('transitionend', (event) => {
		if (event.target !== viewerTrack || event.propertyName !== 'transform' || pendingImageIndex === undefined) return;
		showImage(pendingImageIndex);
	});
	const showPreviousImage = () => {
		if (imageIndex > 0) slideTo(imageIndex - 1);
	};
	const showNextImage = () => {
		if (imageIndex < articleImages.length - 1) slideTo(imageIndex + 1);
	};
	const pointerDistance = () => {
		const [first, second] = [...pointers.values()];
		return first && second ? Math.hypot(second.x - first.x, second.y - first.y) : 0;
	};
	const pointerCenter = () => {
		const [first, second] = [...pointers.values()];
		return first && second ? { x: (first.x + second.x) / 2, y: (first.y + second.y) / 2 } : { x: 0, y: 0 };
	};

	const hasMultipleImages = articleImages.length > 1;
	if (previousImage) previousImage.hidden = !hasMultipleImages;
	if (nextImage) nextImage.hidden = !hasMultipleImages;
	if (viewerCounter) viewerCounter.hidden = !hasMultipleImages;
	articleImages.forEach((image) => {
		image.tabIndex = 0;
		image.setAttribute('role', 'button');
		image.setAttribute('aria-haspopup', 'dialog');
		image.setAttribute('aria-controls', 'image-viewer');
		image.setAttribute('aria-label', image.alt ? `查看图片：${image.alt}` : '查看图片');
		const open = (event: Event) => {
			event.preventDefault();
			if (!imageViewer) return;
			clearTimeout(closeTimer);
			delete imageViewer.dataset.closing;
			showImage(articleImages.indexOf(image));
			imageViewer.showModal();
		};
		image.addEventListener('click', open);
		image.addEventListener('keydown', (event) => {
			if (event.key === 'Enter' || event.key === ' ') open(event);
		});
	});
	previousImage?.addEventListener('click', showPreviousImage);
	nextImage?.addEventListener('click', showNextImage);
	zoomOut?.addEventListener('click', () => setScale(scale / 1.25));
	zoomIn?.addEventListener('click', () => setScale(scale * 1.25));
	resetZoom?.addEventListener('click', resetImageTransform);
	viewerStage?.addEventListener('click', (event) => {
		if (event.target === viewerStage) closeImageViewer();
	});
	viewerClose?.addEventListener('click', closeImageViewer);
	viewerStage?.addEventListener('wheel', (event) => {
		if (event.deltaY === 0) return;
		event.preventDefault();
		setScale(scale * (event.deltaY < 0 ? 1.15 : 1 / 1.15), event.clientX, event.clientY);
	}, { passive: false });
	viewerImage?.addEventListener('dblclick', (event) => {
		setScale(scale > 1 ? 1 : 2, event.clientX, event.clientY);
	});
	viewerImage?.addEventListener('pointerdown', (event) => {
		if (isSliding) return;
		viewerImage.dataset.interacting = 'true';
		pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
		if (pointers.size === 1) {
			swipeStart = { x: event.clientX, y: event.clientY };
			didPinch = false;
		} else if (pointers.size === 2) {
			if (scale === 1) resetImageTransform();
			pinchDistance = pointerDistance();
			pinchCenter = pointerCenter();
			didPinch = true;
		}
	});
	addEventListener('pointermove', (event) => {
		const previous = pointers.get(event.pointerId);
		if (!previous) return;
		event.preventDefault();
		pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
		if (pointers.size === 2) {
			const distance = pointerDistance();
			const center = pointerCenter();
			panX += center.x - pinchCenter.x;
			panY += center.y - pinchCenter.y;
			if (pinchDistance > 0 && distance > 0) setScale(scale * distance / pinchDistance, center.x, center.y);
			pinchDistance = distance;
			pinchCenter = center;
		} else if (scale > 1) {
			panX += event.clientX - previous.x;
			panY += event.clientY - previous.y;
			applyImageTransform();
		} else if (!didPinch && viewerTrack) {
			const offset = event.clientX - swipeStart.x;
			const atBoundary = (offset > 0 && imageIndex === 0) || (offset < 0 && imageIndex === articleImages.length - 1);
			setTrackOffset(atBoundary ? offset / 3 : offset, true);
			viewerImage.dataset.dragging = 'true';
		}
	}, { passive: false });
	const finishPointer = (event: PointerEvent, cancelled = false) => {
		if (!pointers.has(event.pointerId)) return;
		if (!cancelled && !didPinch && pointers.size === 1 && scale === 1) {
			const horizontal = event.clientX - swipeStart.x;
			const vertical = event.clientY - swipeStart.y;
			if (Math.abs(horizontal) > 60 && Math.abs(horizontal) > Math.abs(vertical)) {
				if (horizontal < 0 && imageIndex < articleImages.length - 1) slideTo(imageIndex + 1);
				else if (horizontal > 0 && imageIndex > 0) slideTo(imageIndex - 1);
				else setTrackOffset(0);
			} else setTrackOffset(0);
		}
		pointers.delete(event.pointerId);
		if (pointers.size < 2) pinchDistance = 0;
		if (cancelled && pointers.size === 0 && scale === 1) setTrackOffset(0);
		if (viewerImage && pointers.size === 0) {
			delete viewerImage.dataset.dragging;
			delete viewerImage.dataset.interacting;
		}
	};
	addEventListener('pointerup', finishPointer);
	addEventListener('pointercancel', (event) => finishPointer(event, true));
	imageViewer?.addEventListener('cancel', (event) => {
		event.preventDefault();
		closeImageViewer();
	});
	imageViewer?.addEventListener('close', () => {
		clearTimeout(closeTimer);
		delete imageViewer.dataset.closing;
		pointers.clear();
		isSliding = false;
		pendingImageIndex = undefined;
		resetTrack();
		if (viewerImage) {
			delete viewerImage.dataset.dragging;
			delete viewerImage.dataset.interacting;
		}
	});
	imageViewer?.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeImageViewer();
		else if (event.key === 'ArrowLeft') showPreviousImage();
		else if (event.key === 'ArrowRight') showNextImage();
		else if (event.key === '+' || event.key === '=') setScale(scale * 1.25);
		else if (event.key === '-') setScale(scale / 1.25);
		else if (event.key === '0') resetImageTransform();
		else return;
		event.preventDefault();
	});
	addEventListener('scroll', sync, { passive: true });
	addEventListener('resize', measure);
	addEventListener('load', measure);
	desktopOutline.addEventListener('change', measure);
	measure();
</script>

<style>
	.article-navigation {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		max-width: 760px;
		margin: 4rem 0 0;
		padding-top: 2rem;
		border-top: 1px solid var(--line);
		font-size: 1rem;
	}

	.article-navigation a {
		display: flex;
		min-height: 44px;
		align-items: center;
		color: var(--accent);
		font-family: var(--font-serif);
		font-weight: 600;
		text-decoration: none;
	}


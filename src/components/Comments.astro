<section class="comments" aria-label="评论">
	<div class="comments-loader" role="status">
		<span class="comments-loader-image" aria-hidden="true"></span>
		<span>正在加载评论…</span>
	</div>
	<div class="giscus"></div>
</section>

<script>
	import darkTheme from '../styles/giscus-dark.css?raw';
	import lightTheme from '../styles/giscus-light.css?raw';

	const comments = document.querySelector<HTMLElement>('.comments');
	const loader = comments?.querySelector<HTMLElement>('.comments-loader');
	const themeUrl = () =>
		`data:text/css;charset=utf-8,${encodeURIComponent(document.documentElement.dataset.theme === 'dark' ? darkTheme : lightTheme)}`;
	const syncTheme = () => {
		comments?.querySelector<HTMLIFrameElement>('.giscus-frame')?.contentWindow?.postMessage(
			{ giscus: { setConfig: { theme: themeUrl() } } },
			'https://giscus.app',
		);
	};
	const finishLoading = (event: MessageEvent) => {
		const frame = comments?.querySelector<HTMLIFrameElement>('.giscus-frame');
		const data = event.data?.giscus;
		if (
			event.origin !== 'https://giscus.app' ||
			event.source !== frame?.contentWindow ||
			(!data?.discussion && !data?.error)
		) {
			return;
		}
		comments?.classList.add('comments-loaded');
		loader?.setAttribute('aria-hidden', 'true');
		removeEventListener('message', finishLoading);
	};

	addEventListener('message', finishLoading);
	if (comments) {
		const script = document.createElement('script');
		Object.assign(script.dataset, {
			repo: 'LanternCX/Site',
			repoId: 'R_kgDOT0d5ew',
			category: 'Announcements',
			categoryId: 'DIC_kwDOT0d5e84DDI8m',
			mapping: 'pathname',
			strict: '1',
			reactionsEnabled: '1',
			emitMetadata: '1',
			inputPosition: 'bottom',
			theme: themeUrl(),
			lang: 'zh-CN',
		});
		script.src = 'https://giscus.app/client.js';
		script.crossOrigin = 'anonymous';
		script.async = true;
		comments.append(script);
	}

	const themeObserver = new MutationObserver(syncTheme);
	themeObserver.observe(document.documentElement, { attributeFilter: ['data-theme'] });
</script>

<style>
	.comments {
		position: relative;
		max-width: 760px;
		min-height: 150px;
		margin: 4rem auto 0;
	}

	.comments-loader {
		position: absolute;
		z-index: 1;
		inset: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
		justify-content: center;
		color: var(--muted);
		font-size: 0.875rem;
		pointer-events: none;
		transition: opacity 150ms ease;
	}

	.comments-loader-image {
		width: 48px;
		height: 48px;
		background: center / contain no-repeat url('https://github.githubassets.com/images/mona-loading-default.gif');
	}

	:global(html[data-theme='dark']) .comments-loader-image {
		background-image: url('https://github.githubassets.com/images/mona-loading-dark.gif');
	}

	.comments-loaded .comments-loader {
		opacity: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.comments-loader {
			transition: none;
		}

		.comments-loader-image {
			display: none;
		}
	}
</style>

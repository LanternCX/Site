---
import { getCollection } from 'astro:content';
import { SITE_BRAND } from '../consts';
import { categoryLabel, isArticle } from '../utils/content.mjs';

const entries = await getCollection('blog');
const pages = await getCollection('pages');
const posts = entries.filter(({ id }) => isArticle(id)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const about = pages.find(({ id }) => id === 'about');
const friends = pages.find(({ id }) => id === 'friends');
const path = Astro.url.pathname;
const nav = [
	{ label: '首页', href: '/', current: path === '/' || /^\/page\/\d+\/?$/.test(path) },
	{ label: '分类', href: '/archive/', current: path === '/archive/' },
	{ label: '友链', href: friends ? `/blog/pages/${friends.id}/` : '/', current: /\/pages\/friends\/?$/i.test(path) },
	{ label: '关于', href: about ? `/blog/pages/${about.id}/` : '/#about', current: /\/pages\/about\/?$/i.test(path) },
];
---

<a class="skip-link" href="#main-content">跳到主要内容</a>
<header class="site-header">
	<nav class="nav-bar" aria-label="主要导航">
		<a class="brand" href="/" aria-label={`${SITE_BRAND} 首页`}>{SITE_BRAND}</a>

		<div class="desktop-nav">
			{
				nav.map((item) => (
					<a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
				))
			}
		</div>

		<div class="nav-actions">
			<button class="icon-button" type="button" data-search-open aria-label="搜索文章">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="11" cy="11" r="6.5"></circle>
					<path d="m16 16 4 4"></path>
				</svg>
			</button>
			<button class="icon-button" type="button" data-theme-toggle aria-label="切换至深色主题">
				<svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="3.5"></circle>
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
				</svg>
				<svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M20 15.2A8 8 0 0 1 8.8 4a8 8 0 1 0 11.2 11.2Z"></path>
				</svg>
			</button>

			<details class="mobile-menu">
				<summary class="icon-button" aria-label="打开导航菜单">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M4 7h16M4 12h16M4 17h16"></path>
					</svg>
				</summary>
				<div class="menu-panel">
					{
						nav.map((item) => (
							<a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
						))
					}
				</div>
			</details>
		</div>
	</nav>
</header>

<dialog class="search-dialog" aria-labelledby="search-title">
	<form method="dialog" class="search-head">
		<div>
			<p class="search-label">站内搜索</p>
			<h2 id="search-title">查找文章</h2>
		</div>
		<button class="icon-button" aria-label="关闭搜索">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg>
		</button>
	</form>
	<label class="search-field">
		<span class="visually-hidden">搜索标题或摘要</span>
		<input type="search" placeholder="输入标题或关键词" autocomplete="off" data-search-input />
	</label>
	<ul class="search-results" data-search-results>
		{
			posts.map((post) => (
				<li data-search-item data-search={`${post.data.title} ${post.data.description ?? ''} ${categoryLabel(post.id, post.filePath)} ${post.id}`.toLowerCase()}>
					<a href={`/blog/${post.id}/`}>
						<span>{post.data.title}</span>
						<time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(0, 10)}</time>
					</a>
				</li>
			))
		}
	</ul>
	<p class="search-empty" data-search-empty hidden>没有找到匹配的文章。</p>
</dialog>

<script>
	const root = document.documentElement;
	const themeButtons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
	const syncThemeButtons = () => {
		const next = root.dataset.theme === 'dark' ? '浅色' : '深色';
		themeButtons.forEach((button) => (button.ariaLabel = `切换至${next}主题`));
	};
	themeButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
			root.dataset.theme = theme;
			root.style.colorScheme = theme;
			try {
				localStorage.setItem('theme', theme);
			} catch {}
			syncThemeButtons();
		});
	});
	syncThemeButtons();

	const dialog = document.querySelector<HTMLDialogElement>('.search-dialog');
	const input = dialog?.querySelector<HTMLInputElement>('[data-search-input]');
	const items = [...(dialog?.querySelectorAll<HTMLElement>('[data-search-item]') ?? [])];
	const empty = dialog?.querySelector<HTMLElement>('[data-search-empty]');
	document.querySelector('[data-search-open]')?.addEventListener('click', () => {
		dialog?.showModal();
		input?.focus();
	});
	input?.addEventListener('input', () => {
		const query = input.value.trim().toLowerCase();
		let matches = 0;
		items.forEach((item) => {
			item.hidden = !item.dataset.search?.includes(query);
			if (!item.hidden) matches++;
		});
		if (empty) empty.hidden = matches > 0;
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: 1px solid var(--line);
		background: color-mix(in srgb, var(--surface) 92%, transparent);
		backdrop-filter: blur(12px);
	}

	.nav-bar {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		width: min(100%, 1280px);
		height: var(--header-height);
		margin: 0 auto;
		padding: 0 var(--page-gutter);
	}

	.brand {
		width: max-content;
		color: var(--accent);
		font-family: var(--font-serif);
		font-size: 1.125rem;
		font-weight: 600;
		letter-spacing: 0.32em;
		text-decoration: none;
	}

	.desktop-nav {
		display: flex;
		gap: 2.75rem;
		align-items: center;
		align-self: stretch;
	}

	.desktop-nav a,
	.menu-panel a,
	.menu-panel button {
		color: var(--text);
		font-size: 0.875rem;
		text-decoration: none;
	}

	.desktop-nav a {
		display: flex;
		align-items: center;
		padding: 0;
		border-bottom: 2px solid transparent;
	}

	.desktop-nav a:hover,
	.desktop-nav a[aria-current='page'] {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}

	.nav-actions {
		display: flex;
		justify-content: flex-end;
		gap: 0.25rem;
	}

	.icon-button {
		display: inline-grid;
		width: 44px;
		height: 44px;
		padding: 0;
		place-items: center;
		border: 0;
		background: transparent;
		color: var(--text);
		cursor: pointer;
	}

	.icon-button:hover {
		color: var(--accent);
	}

	.icon-button svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.75;
	}

	.moon,
	:global(html[data-theme='dark']) .sun {
		display: none;
	}

	:global(html[data-theme='dark']) .moon {
		display: block;
	}

	.mobile-menu {
		display: none;
		position: relative;
	}

	.mobile-menu summary {
		list-style: none;
	}

	.mobile-menu summary::-webkit-details-marker {
		display: none;
	}

	.menu-panel {
		position: absolute;
		top: 52px;
		right: 0;
		display: grid;
		width: min(16rem, calc(100vw - 40px));
		padding: 0.5rem;
		border: 1px solid var(--line);
		background: var(--surface);
		box-shadow: var(--shadow);
	}

	.menu-panel a,
	.menu-panel button {
		padding: 0.8rem 1rem;
		border: 0;
		background: transparent;
		text-align: left;
	}

	.menu-panel a:hover,
	.menu-panel button:hover,
	.menu-panel a[aria-current='page'] {
		background: var(--accent-soft);
		color: var(--accent);
	}

	.search-dialog {
		width: min(42rem, calc(100vw - 40px));
		max-height: min(44rem, calc(100vh - 40px));
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: var(--surface);
		color: var(--text);
		box-shadow: var(--shadow);
	}

	.search-dialog::backdrop {
		background: color-mix(in srgb, var(--canvas) 72%, transparent);
		backdrop-filter: blur(3px);
	}

	.search-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.5rem;
		border-bottom: 1px solid var(--line);
	}

	.search-head h2,
	.search-head p {
		margin: 0;
	}

	.search-head h2 {
		font-family: var(--font-serif);
		font-size: 1.5rem;
	}

	.search-label {
		color: var(--accent);
		font-size: 0.75rem;
	}

	.search-field {
		display: block;
		padding: 1rem 1.5rem;
	}

	.search-field input {
		width: 100%;
		min-height: 48px;
		padding: 0 1rem;
		border: 1px solid var(--line);
		border-radius: 4px;
		background: var(--canvas);
		color: var(--text);
		font: inherit;
	}

	.search-results {
		max-height: 24rem;
		margin: 0;
		padding: 0 1.5rem 1.5rem;
		overflow-y: auto;
		list-style: none;
	}

	.search-results li {
		border-bottom: 1px solid var(--line);
	}

	.search-results a {
		display: flex;
		gap: 1rem;
		align-items: baseline;
		justify-content: space-between;
		padding: 0.9rem 0;
		color: var(--text);
		text-decoration: none;
	}

	.search-results a:hover span {
		color: var(--accent);
	}

	.search-results time {
		flex: none;
		color: var(--muted);
		font-size: 0.75rem;
	}

	.search-empty {
		margin: 0;
		padding: 1rem 1.5rem 2rem;
		color: var(--muted);
	}

	@media (max-width: 720px) {
		.nav-bar {
			grid-template-columns: 1fr auto;
		}

		.desktop-nav {
			display: none;
		}

		.mobile-menu {
			display: block;
		}

		.search-head,
		.search-field,
		.search-results {
			padding-right: 1rem;
			padding-left: 1rem;
		}
	}
</style>

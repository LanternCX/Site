---
import type { CollectionEntry } from 'astro:content';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import { SITE_DESCRIPTION, SITE_KEYWORDS, SITE_TITLE } from '../consts';
import { categoryLabel, categoryOf, excerpt, formatDate, paginationItems } from '../utils/content.mjs';

interface Props {
	posts: CollectionEntry<'blog'>[];
	allPosts: CollectionEntry<'blog'>[];
	currentPage: number;
	lastPage: number;
}

const { posts, allPosts, currentPage, lastPage } = Astro.props;
const topicCounts = [...new Set(allPosts.map(({ id }) => categoryOf(id)))].map((category) => {
	const entries = allPosts.filter(({ id }) => categoryOf(id) === category);
	return { category, label: categoryLabel(entries[0].id, entries[0].filePath), count: entries.length };
});
const keywords = [...SITE_KEYWORDS, ...topicCounts.flatMap(({ category, label }) => [category, label])];
const pageUrl = (page: number) => page === 1 ? '/' : `/page/${page}/`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={currentPage === 1 ? SITE_TITLE : `第 ${currentPage} 页 · ${SITE_TITLE}`}
			description={SITE_DESCRIPTION}
			keywords={keywords}
		/>
	</head>
	<body>
		<div class="site-shell">
			<Header />
			<main id="main-content" class="home">
				<header class="hero" data-hero>
					<div class="hero-copy">
						<img class="hero-avatar" src="/images/avatar.jpg" alt="CaoXin" width="112" height="112" />
						<h1>
							<span
								aria-hidden="true"
								data-typewriter
								data-phrases='["欢迎来到我的小站\\o/","O Captain! My Captain!","さよなら,全てのEvangelion","Never Fade Away.","Do not go gentle into that good night.","Get busy living or get busy dying."]'
							>欢迎来到我的小站\o/</span>
							<span class="visually-hidden">欢迎来到我的小站。</span>
						</h1>
						<nav class="hero-social" aria-label="社交链接">
							<a href="https://github.com/LanternCX" target="_blank" rel="me noopener noreferrer" aria-label="GitHub">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path class="filled" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.61-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.84a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg>
							</a>
							<a href="https://space.bilibili.com/453847656" target="_blank" rel="me noopener noreferrer" aria-label="Bilibili">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 3 3 3m5-3-3 3M5 7h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2Zm4 5v2m6-2v2" /></svg>
							</a>
							<a href="https://x.com/LanternCX" target="_blank" rel="me noopener noreferrer" aria-label="X">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4 19 20M19 4 5 20" /></svg>
							</a>
						</nav>
					</div>
				</header>

				<div class="home-content">
					<div class="home-index page-content">
						<section id="articles" class="latest-section" aria-label="文章">
							<ol class="post-list">
							{
								posts.map((post) => (
									<li data-post>
										<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
										<div class="post-copy">
											<a href={`/blog/${post.id}/`}>{post.data.title}</a>
											<p>{post.data.description ?? excerpt(post.body)}</p>
										</div>
										<span class="topic">{categoryLabel(post.id, post.filePath)}</span>
									</li>
								))
							}
							</ol>
							<nav class="pagination" aria-label="文章分页">
								{
									currentPage > 1 ? (
										<a class="pagination-arrow" href={pageUrl(currentPage - 1)} aria-label="上一页">
											<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"></path></svg>
										</a>
									) : (
										<span class="pagination-arrow is-disabled" aria-hidden="true">
											<svg viewBox="0 0 24 24"><path d="m15 5-7 7 7 7"></path></svg>
										</span>
									)
								}
								{
									paginationItems(currentPage, lastPage).map((item) =>
										item === '…' ? (
											<span class="pagination-ellipsis" aria-hidden="true">•••</span>
										) : (
											<a class="pagination-page" href={pageUrl(item)} aria-current={item === currentPage ? 'page' : undefined}>{item}</a>
										),
									)
								}
								{
									currentPage < lastPage ? (
										<a class="pagination-arrow" href={pageUrl(currentPage + 1)} aria-label="下一页">
											<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"></path></svg>
										</a>
									) : (
										<span class="pagination-arrow is-disabled" aria-hidden="true">
											<svg viewBox="0 0 24 24"><path d="m9 5 7 7-7 7"></path></svg>
										</span>
									)
								}
							</nav>
						</section>
					</div>
				</div>
			</main>
			<Footer />
		</div>
	</body>
</html>

<script>
	import Typewriter from 'typewriter-effect/dist/core';

	const target = document.querySelector<HTMLElement>('[data-typewriter]');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (target && !reduceMotion) {
		const phrases = JSON.parse(target.dataset.phrases ?? '[]');
		target.textContent = '';
		const typewriter = new Typewriter(target, { loop: true });
		phrases.forEach((phrase: string) => {
			typewriter.typeString(phrase).pauseFor(2500).deleteAll();
		});
		typewriter.start();
	}
</script>

<style>
	.home {
		position: relative;
	}

	.hero {
		position: sticky;
		top: var(--header-height);
		z-index: 0;
		display: grid;
		height: clamp(12rem, 33svh, 17rem);
		place-items: center;
		overflow: clip;
		background: var(--canvas);
		text-align: center;
	}

	.hero-copy {
		position: relative;
		z-index: 1;
		display: grid;
		width: min(92%, 46rem);
		gap: 0.5rem;
		justify-items: center;
	}

	.hero-avatar {
		width: 4.5rem;
		height: 4.5rem;
		border: 5px solid var(--surface);
		border-radius: 50%;
		object-fit: cover;
	}

	.hero h1 {
		display: grid;
		width: 100%;
		min-height: 2em;
		margin: 0;
		place-items: center;
		color: var(--text);
		font-family: var(--font-serif);
		font-size: clamp(1.35rem, 2.4vw, 1.8rem);
		font-weight: 600;
		letter-spacing: 0.01em;
		line-height: 1.4;
	}

	.hero-social {
		display: flex;
		gap: 1rem;
	}

	.hero-social a {
		display: grid;
		width: 48px;
		height: 48px;
		place-items: center;
		border: 1px solid var(--line);
		border-radius: 50%;
		background: var(--surface);
		color: var(--text);
	}

	.hero-social a:hover {
		color: var(--accent);
	}

	.hero-social svg {
		width: 23px;
		height: 23px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}

	.hero-social .filled {
		fill: currentColor;
		stroke: none;
	}

	.home-content {
		position: relative;
		z-index: 1;
		background: var(--surface);
	}

	.home-index {
		padding-top: clamp(2rem, 4vw, 3.5rem);
		padding-bottom: clamp(3rem, 6vw, 5rem);
	}

	.latest-section {
		scroll-margin-top: 2rem;
	}

	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post-list li {
		position: relative;
		display: grid;
		grid-template-columns: 8rem minmax(0, 1fr) 6rem;
		gap: 2rem;
		align-items: start;
		margin: 0 -1rem;
		padding: 1.1rem 1rem;
		border-bottom: 1px solid var(--line);
		transition: background-color 160ms ease;
	}

	.post-list li:hover,
	.post-list li:focus-within {
		background: var(--accent-soft);
	}

	.post-list time,
	.topic {
		padding-top: 0.15rem;
		color: var(--muted);
		font-size: 0.78rem;
		font-variant-numeric: tabular-nums;
	}

	.post-copy a {
		color: var(--text);
		font-family: var(--font-serif);
		font-size: clamp(1.2rem, 2vw, 1.35rem);
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.35;
		text-decoration: none;
	}

	.post-copy a:hover {
		color: var(--accent);
	}

	.post-copy a::after {
		position: absolute;
		content: '';
		inset: 0;
	}

	.post-copy p {
		margin: 0.45rem 0 0;
		color: var(--muted);
		display: -webkit-box;
		overflow: hidden;
		font-size: 0.9rem;
		line-height: 1.6;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.topic {
		color: var(--accent);
		font-weight: 700;
		text-align: right;
	}

	.pagination {
		display: flex;
		gap: 0.2rem;
		align-items: center;
		justify-content: center;
		margin-top: 3rem;
	}

	.pagination-page,
	.pagination-arrow,
	.pagination-ellipsis {
		display: grid;
		width: 2.5rem;
		height: 2.75rem;
		place-items: center;
		color: var(--muted);
		font-size: 1rem;
		text-decoration: none;
	}

	.pagination-page:hover,
	.pagination-arrow:hover,
	.pagination-page[aria-current='page'] {
		color: var(--text);
	}

	.pagination-page[aria-current='page'] {
		font-weight: 700;
	}

	.pagination-arrow svg {
		width: 1.5rem;
		height: 1.5rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}

	.pagination-arrow.is-disabled {
		opacity: 0.3;
	}

	.pagination-ellipsis {
		font-size: 0.65rem;
		letter-spacing: 0.22em;
	}

	@media (max-width: 720px) {
		.hero h1 {
			min-height: 4.2em;
			font-size: clamp(1.1rem, 5vw, 1.4rem);
		}

		.post-list li {
			grid-template-columns: 1fr auto;
			gap: 0.35rem 1rem;
			margin: 0 -0.75rem;
			padding: 1rem 0.75rem;
		}

		.post-copy {
			grid-column: 1 / -1;
			grid-row: 2;
		}

		.post-copy a {
			font-size: 1.18rem;
		}

		.topic {
			grid-column: 2;
			grid-row: 1;
		}

	}

	@media (prefers-reduced-motion: reduce) {
		.hero {
			position: relative;
			top: auto;
		}
	}
</style>

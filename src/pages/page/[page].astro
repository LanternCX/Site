---
import { getCollection } from 'astro:content';
import HomePage from '../../components/HomePage.astro';
import { pagesOf } from '../../utils/content.mjs';

export async function getStaticPaths() {
	const allPosts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
	const pages = pagesOf(allPosts, 8);
	return pages.slice(1).map((posts, index) => ({
		params: { page: String(index + 2) },
		props: { posts, allPosts, currentPage: index + 2, lastPage: pages.length },
	}));
}

const { posts, allPosts, currentPage, lastPage } = Astro.props;
---

<HomePage {posts} {allPosts} {currentPage} {lastPage} />
